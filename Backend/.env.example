PORT=5000
NODE_ENV=production
MONGODB_URI=your_mongodb_atlas_uri
JWT_SECRET=your_jwt_secret
BACKEND_PUBLIC_URL=https://billingapi.duckdns.org

# Cloudinary (optional store logo storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App version metadata
APP_LATEST_VERSION=1.1.0
APP_APK_URL=https://github.com/jayeetamajumdar15-dev/billingapp/raw/main/BillingApp-release.apk

# Gmail SMTP (easiest for sending OTPs/Alerts directly from Gmail using a 16-char Google App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# AWS Messaging Services (SQS + SNS + SES)
AWS_REGION=ap-south-1
# Optional if running on EC2 with an IAM Role attached:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 1. AWS SQS Queue URL (1M free requests/month forever — enables instant non-blocking billing & broadcasts)
AWS_SQS_QUEUE_URL=
# 2. AWS SNS SMS (set to true after enabling SNS SMS / DLT in India)
AWS_SNS_SMS_ENABLED=false
AWS_SNS_SENDER_ID=BILLAPP
AWS_SNS_TOPIC_ARN=
# 3. AWS SES Email (verified sender email for receipts/OTPs)
AWS_SES_FROM_EMAIL=
# Set to true only when running a separate worker (`pm2 start worker.js`)
DISABLE_EMBEDDED_WORKER=false

# Microservices Topology (used by gateway.js and ecosystem.config.cjs)
CORE_SERVICE_URL=http://127.0.0.1:5001
BILLING_SERVICE_URL=http://127.0.0.1:5002
REPORTS_SERVICE_URL=http://127.0.0.1:5003
MESSAGING_SERVICE_URL=http://127.0.0.1:5004

# Company Admin Portal (/api/admin) to link platform 'system' WhatsApp & test email
ADMIN_SETUP_KEY=change_this_admin_key

